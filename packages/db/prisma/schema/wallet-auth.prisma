model WalletIdentity {
  address String @id @db.VarChar(42)
  userId String @unique @db.Uuid
  agentId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastLoginAt DateTime @db.Timestamptz(3)
  @@schema("auth")
}

model WalletChallenge {
  id String @id @db.Uuid
  address String @db.VarChar(42)
  message String
  bindingHash String @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  @@index([expiresAt])
  @@schema("auth")
}

model WalletSession {
  tokenHash String @id @db.VarChar(64)
  userId String @db.Uuid
  agentId String @db.Uuid
  address String @db.VarChar(42)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([expiresAt])
  @@schema("auth")
}
