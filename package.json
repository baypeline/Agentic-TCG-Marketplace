{
  "name": "agentic-tcg-marketplace",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "env:init": "node scripts/init-env.mjs",
    "agent:wallet:init": "pnpm --filter @tcg/api wallet:init",
    "dev": "pnpm --parallel --filter @tcg/web --filter @tcg/api run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:db": "node scripts/test-db.mjs",
    "turbo:dev": "turbo run dev --filter=@tcg/web --filter=@tcg/api",
    "turbo:build": "turbo run build",
    "db:generate": "pnpm --filter @tcg/db db:generate",
    "db:migrate": "pnpm --filter @tcg/db db:migrate",
    "db:check": "pnpm --filter @tcg/db db:check",
    "db:seed": "pnpm --filter @tcg/db db:seed",
    "db:seed:collected": "pnpm --filter @tcg/db db:seed:collected",
    "demo:seed": "pnpm --filter @tcg/db demo:seed",
    "trading:seed": "pnpm --filter @tcg/trading seed:demo",
    "fixtures:export": "pnpm --filter @tcg/db fixtures:export",
    "cards:collect": "pnpm --filter @tcg/aggregator collect",
    "cards:collect:set": "pnpm --filter @tcg/aggregator collect:set",
    "cards:localize": "pnpm --filter @tcg/aggregator localize",
    "prices:collect": "pnpm --filter @tcg/valuation prices:collect",
    "prices:assess": "pnpm --filter @tcg/valuation prices:assess",
    "prices:check": "pnpm --filter @tcg/valuation prices:check",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "turbo": "2.11.13",
    "vitest": "4.1.12"
  }
}
