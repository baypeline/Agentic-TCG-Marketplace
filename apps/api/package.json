{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "name": "@tcg/api",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "wallet:init": "node scripts/init-agent-wallet.mjs",
    "maroo:init": "node scripts/init-maroo.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tcg/agent": "workspace:*",
    "@tcg/aggregator": "workspace:*",
    "@tcg/config": "workspace:*",
    "@tcg/contracts": "workspace:*",
    "@tcg/db": "workspace:*",
    "@tcg/mcp-server": "workspace:*",
    "@tcg/payment-client": "workspace:*",
    "@tcg/payment-server": "workspace:*",
    "@tcg/trading": "workspace:*",
    "@tcg/valuation": "workspace:*",
    "dotenv": "^17.2.3",
    "fastify": "5.12.8",
    "viem": "^2.58.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
