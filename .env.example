NODE_ENV=development
# Web / API / PostgreSQL 포트. pnpm env:init은 사용 가능한 임의 포트를 생성합니다.
PORT=3000
API_HOST=127.0.0.1
API_PORT=4000
CORE_API_URL=http://127.0.0.1:4000
DATA_MODE=mock
CARD_DATA_SOURCE=mock
# market는 DB에 저장된 검증 표본만 사용합니다. Mock으로 자동 대체하지 않습니다.
PRICE_DATA_SOURCE=mock
# database 거래에는 DATABASE_ENABLED=true, CARD_DATA_SOURCE=database가 필요합니다.
TRADING_DATA_SOURCE=mock
TRADING_SWEEP_INTERVAL_MS=30000
# 결제는 기본 비활성. true에는 DB 거래 모드와 두 공개 주소가 필요합니다.
PAYMENT_ENABLED=false
# PAYMENT_RECIPIENT=0x...
# AGENT_WALLET_ADDRESS=0x...
# Web 수동 거래 관리의 로컬 역할. 토큰 자체는 브라우저에 전달하지 않습니다.
# WEB_DEMO_ROLE=buyer
# 로컬 거래 시연용. 서로 다른 토큰을 각각 32자 이상 생성해 함께 설정하세요.
# DEMO_SELLER_TOKEN=<random-seller-token>
# DEMO_BUYER_TOKEN=<random-buyer-token>
# Mock 데모는 DB 없이 실행. 연결 검증 시 true로 변경.
DATABASE_ENABLED=false
# 로컬 웹 에이전트를 사용하려면 OpenAI 키와 32자 이상 무작위 비밀값을 설정합니다.
OPENAI_API_KEY=
AGENT_LOCAL_SECRET=
POSTGRES_USER=tcg
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=tcg
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tcg:replace-with-a-random-password@127.0.0.1:5432/tcg?schema=public
