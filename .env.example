# 로컬 개발용 환경변수 예시
# 모든 모듈은 루트 .env를 공유합니다. 실제 키·토큰·비밀번호는 이 파일에 넣지 않습니다.
# pnpm env:init은 임의 포트·DB 계정·비밀번호·Agent 세션 비밀값을 생성하며 기존 .env는 덮어쓰지 않습니다.
# 아래 포트와 DB 계정은 수동 설정 예시입니다. 생성된 .env의 값이 우선합니다.
# 비밀값에 NEXT_PUBLIC_ 접두사를 붙이지 마세요. 값을 변경하면 Web·API 서버를 재시작합니다.

# -----------------------------------------------------------------------------
# 1. 공통 실행 환경 · Web · Core API
# -----------------------------------------------------------------------------
# development | test | production. 로컬 채팅과 데모 인증은 아래 각 조건을 따릅니다.
NODE_ENV=development
# Next.js Web 포트
PORT=3000
# Fastify 바인딩 주소. 로컬 채팅·데모 인증을 쓸 때는 루프백 주소를 유지합니다.
API_HOST=127.0.0.1
API_PORT=4000
# Web 서버가 호출할 Core API 주소. API_PORT를 바꾸면 이 주소도 맞춰 주세요.
CORE_API_URL=http://127.0.0.1:4000

# -----------------------------------------------------------------------------
# 2. PostgreSQL · Prisma · DB 통합 테스트
# -----------------------------------------------------------------------------
# false면 API에서 DB에 연결하지 않습니다. DB 카드·거래 조회를 사용할 때 true로 설정합니다.
DATABASE_ENABLED=false
# Docker Compose의 PostgreSQL 초기 계정·비밀번호·DB 이름
# 비밀번호는 무작위 값으로 교체하세요. 기존 볼륨의 계정은 이 값을 바꿔도 변경되지 않습니다.
POSTGRES_USER=tcg
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=tcg
# 호스트에 공개할 DB 포트. 컨테이너 내부 포트는 5432입니다.
POSTGRES_PORT=5432
# Prisma 접속 주소. 위 계정·비밀번호·DB 이름·POSTGRES_PORT와 일치해야 합니다.
# 특수문자가 포함된 계정·비밀번호는 URL 인코딩이 필요합니다.
DATABASE_URL=postgresql://tcg:replace-with-a-random-password@127.0.0.1:5432/tcg?schema=public
# 선택: pnpm test:db용 별도 DB. 생략하면 DATABASE_URL을 사용합니다.
# 별도 DB를 사용할 때는 해당 DB에도 Migration을 먼저 적용하세요.
# DATABASE_TEST_URL=postgresql://tcg:replace-with-a-random-password@127.0.0.1:5432/tcg_test?schema=public

# -----------------------------------------------------------------------------
# 3. 카드 데이터 · 적정가 평가
# -----------------------------------------------------------------------------
# 현재 지원하는 값은 mock뿐입니다. 외부 데이터 사용 여부는 아래 항목으로 선택합니다.
DATA_MODE=mock
# mock: 합성 카드 / database: 수집·저장된 DB 카드. database에는 DATABASE_ENABLED=true가 필요합니다.
CARD_DATA_SOURCE=mock
# mock: 합성 가격 표본 / market: DB의 검증된 시장 표본으로 평가
# market에는 DATABASE_ENABLED=true, CARD_DATA_SOURCE=database가 필요합니다.
# 검증 표본이 부족하면 자료 부족으로 응답하며 Mock 가격으로 자동 대체하지 않습니다.
PRICE_DATA_SOURCE=mock

# -----------------------------------------------------------------------------
# 4. OpenAI · 로컬 Web Agent 채팅
# -----------------------------------------------------------------------------
# 실제 모델 호출에 사용하는 서버 전용 키. 카드 조회·거래 모듈의 Mock 실행에는 필요 없습니다.
OPENAI_API_KEY=
# 브라우저 세션 식별자를 서명하는 무작위 비밀값(32자 이상). Web과 API가 같은 값을 사용합니다.
# 로컬 Web 채팅에는 위 API 키와 이 값이 모두 필요합니다.
# NODE_ENV=development이며 Web·Core API 주소가 루프백일 때만 활성화됩니다.
AGENT_LOCAL_SECRET=
# 선택: 대화 모델 / 의도 분류 모델. 생략하면 Agent 패키지의 기본 모델을 사용합니다.
# 계정에서 사용할 수 있는 모델 ID로 지정하세요.
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_DECISION_MODEL=gpt-5.6-luna

# -----------------------------------------------------------------------------
# 5. 거래 저장소 · 복구 주기 · 로컬 Web 거래 인증
# -----------------------------------------------------------------------------
# mock: 메모리 거래 저장소 / database: Prisma 거래 저장소
# database에는 DATABASE_ENABLED=true, CARD_DATA_SOURCE=database와 Migration·시연 재고가 필요합니다.
TRADING_DATA_SOURCE=mock
# 실행 기한·예약 만료·결제 복구 점검 간격(ms). 허용 범위: 100~3600000, 기본 30초.
TRADING_SWEEP_INTERVAL_MS=30000
# 선택: 로컬 거래 시연용 토큰. 서로 다른 무작위 값(각 32자 이상)을 반드시 함께 설정합니다.
# API_HOST가 루프백이고 NODE_ENV가 production이 아닐 때만 허용합니다.
# Agent 채팅의 AGENT_LOCAL_SECRET과는 별개의 인증입니다.
# DEMO_SELLER_TOKEN=<random-seller-token>
# DEMO_BUYER_TOKEN=<random-buyer-token>
# 선택: Web 수동 거래 화면의 역할(buyer | seller). 해당 역할의 위 토큰을 서버에서 사용합니다.
# 토큰 자체는 브라우저에 전달하지 않습니다. 미설정 시 로컬 역할 인증을 사용하지 않습니다.
# WEB_DEMO_ROLE=buyer

# -----------------------------------------------------------------------------
# 6. MCP · Agent CLI 데모
# -----------------------------------------------------------------------------
# 선택: Agent CLI 데모가 연결할 Streamable HTTP MCP 서버 주소
# 미설정이면 CLI는 로컬 Mock 카드·가격 서비스를 사용합니다.
# Web 채팅을 자동으로 이 MCP 서버에 연결하는 설정은 아닙니다.
# AGENT_MCP_URL=http://127.0.0.1:4000/mcp
# 선택: 해당 MCP 서버가 Bearer 인증을 요구하면 설정합니다.
# AGENT_MCP_TOKEN=<server-issued-bearer-token>

# -----------------------------------------------------------------------------
# 7. x402 · Base Sepolia 테스트 USDC 결제
# -----------------------------------------------------------------------------
# 기본 비활성. true에는 DATABASE_ENABLED=true, CARD_DATA_SOURCE=database,
# TRADING_DATA_SOURCE=database 및 아래 두 공개 지갑 주소가 모두 필요합니다.
# true만으로 Web 지급 서명이나 LLM 자율 구매 실행기가 연결되지는 않습니다.
PAYMENT_ENABLED=false
# 선택: 플랫폼 수납 지갑 주소. 판매자 지갑이나 Facilitator 주소가 아닙니다.
# PAYMENT_RECIPIENT=0x...
# 선택: 로컬 데모 구매자 Agent의 지급 지갑 주소. 개인키가 아닌 공개 주소입니다.
# AGENT_WALLET_ADDRESS=0x...
